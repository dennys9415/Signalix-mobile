{
  "expo": {
    "name": "Signalix",
    "slug": "signalix-mobile",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "signalix",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thesingularitybox.signalix",
      "infoPlist": {
        "NSCameraUsageDescription": "Signalix uses the camera for video calls and to take a profile picture.",
        "NSMicrophoneUsageDescription": "Signalix uses the microphone for voice and video calls.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "appleTeamId": "25YU98RK6C"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.thesingularitybox.signalix",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Signalix uses your photos so you can set a profile picture.",
          "cameraPermission": "Signalix uses the camera for video calls and to take a profile picture."
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000",
      "wsUrl": "ws://10.0.2.2:5000",
      "eas": {
        "projectId": "55850128-dedd-485a-8031-f7d4e96374e1"
      }
    },
    "owner": "denn9415"
  }
}
