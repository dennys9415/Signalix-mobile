{
  "expo": {
    "name": "Signalix",
    "slug": "signalix-mobile",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "signalix",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.signalix.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.signalix.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Signalix uses your photos so you can set a profile picture.",
          "cameraPermission": "Signalix uses the camera so you can take a profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000",
      "wsUrl": "ws://10.0.2.2:5000"
    }
  }
}
